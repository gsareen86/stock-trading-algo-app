# =============================================================================
# Daily Driver Platform — Environment Configuration Example
# Copy to `.env` (at repo root or inside `backend/.env`) and fill in values.
# Precedence: process env > .env > defaults in backend/app/core/settings.py
# =============================================================================

# --- Application & Web Seam --------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000

# Next.js BFF proxy target (read by `web/lib/backend.ts` and `web/app/api/backend/**`)
BACKEND_URL=http://127.0.0.1:8000

# --- Database (Supabase Postgres in prod/cloud, SQLite in local dev) ---------
# Local SQLite dev fallback (no setup required):
DATABASE_URL=sqlite+pysqlite:///./trading.db

# Cloud Supabase Postgres (project `trading` schema with RLS enabled):
# DATABASE_URL=postgresql+psycopg://postgres:<YOUR_DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# --- Authentication (required in APP_ENV=prod; min 32 chars) ----------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace-with-a-random-48-byte-url-safe-secret-key
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=14
# Set true when serving Next.js over HTTPS
AUTH_COOKIE_SECURE=false

# --- LLM Gateway (Local Ollama / llama.cpp / Hosted) -------------------------
# Default model for unrouted tasks (`<provider>/<model>`)
LLM_DEFAULT_TASK_MODEL=ollama/gemma4:12b
# Task-level routing overrides (e.g. local narrative + frontier research)
LLM_ROUTE__NARRATIVE=ollama/gemma4:12b
LLM_ROUTE__RESEARCH=ollama/gemma4:12b
# Local OpenAI-compatible servers (optional):
# LLM_PROVIDER_BASE_URL__LLAMA_CPP=http://127.0.0.1:8080/v1
# LLM_PROVIDER_BASE_URL__LM_STUDIO=http://127.0.0.1:1234/v1

# Wait up to 300s for local models (hosted calls still use LLM_TIMEOUT_SECONDS=30)
LLM_LOCAL_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=30
USD_INR_RATE=88.5
LLM_DAILY_BUDGET_INR=500

# Hosted LLM credentials (optional — only needed if routing tasks to them)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- Market, Search & Broker Providers (all optional) ------------------------
# Tavily web search for theme participants & research (free tier 1,000/mo)
# TAVILY_API_KEY=
# Indian API financials & ratios (free tier 500/mo)
# INDIAN_API_KEY=
# Zerodha Kite MCP server (read-only portfolio / quotes integration)
# MCP_SERVER__KITE=https://mcp.kite.trade/mcp

# --- Scheduled Runs (IST, off by default) ------------------------------------
# Daily post-close Nifty 750 discovery scan + weekly theme research
SCHEDULER_ENABLED=false
SCAN_RUN_HOUR=16
SCAN_RUN_MINUTE=15
THEME_RUN_DAY=sun
THEME_RUN_HOUR=8

# --- Observability (optional Langfuse tracing) -------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
